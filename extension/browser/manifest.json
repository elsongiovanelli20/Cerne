{
  "manifest_version": 3,
  "name": "Cerne — Copiloto do Navegador",
  "short_name": "Cerne",
  "version": "1.3.0",
  "description": "Deixa o seu agente Cerne operar, com a sua permissão, o navegador que você já usa (Chrome/Edge): abrir páginas, ler, preencher, clicar e baixar — com uma moldura visível enquanto atua.",
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "permissions": ["tabs", "activeTab", "scripting", "downloads", "storage", "notifications", "alarms"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_icon": "icons/icon48.png", "default_title": "Cerne — Copiloto do Navegador" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
