# ==== Cerne — configuração do stack (MODELO) ====
# Copie este arquivo para .env e preencha os segredos. NUNCA versione o .env real.
#   Linux/Mac:  cp .env.example .env
#   Windows:    copy .env.example .env

COMPOSE_PROJECT_NAME=cerne

# ---- Modelos servidos pelo Ollama (mapeamento real em gateway/litellm-config.yaml) ----
CHAT_MODEL=qwen2.5:3b
EMBED_MODEL=nomic-embed-text
EMBED_DIM=1024                 # dimensão do vetor do modelo de embedding

# ---- Portas expostas no host ----
GATEWAY_PORT=4000
APP_PORT=8000

# ---- Chave mestra do gateway (LiteLLM) — OBRIGATÓRIA ----
# Gere uma forte, ex.:  sk-cerne-$(openssl rand -hex 24)
LITELLM_MASTER_KEY=

# ---- Provedores externos (OPCIONAIS; preencha só o que for usar) ----
# O app mascara a PII ANTES de chamar qualquer um destes. Vazio = provedor desligado.
GROQ_API_KEY=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=
DASHSCOPE_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
MOONSHOT_API_KEY=
NVIDIA_API_KEY=            # build.nvidia.com (trial grátis: protótipo/teste) — Nemotron Ultra/Lightning, Mistral Large 4, Gemma 4

# ---- Observabilidade (LiteLLM nativo: Postgres + UI) ----
LITELLM_DB_PASSWORD=           # gere uma senha forte
UI_USERNAME=admin
UI_PASSWORD=                   # gere uma senha forte

# ---- Neo4j (grafo de entidades / RAG híbrido) ----
NEO4J_PASS=                    # gere uma senha forte

# ---- Login do painel ----
# Senha inicial do admin (admin@orqion.com.br). Se vazio, o app gera uma e imprime
# no log (docker logs cerne-app). O 1º login sempre exige troca de senha.
ADMIN_SENHA=
AUTH_TTL_HORAS=12

# ---- PicoClaw (porta de entrada por mensagem → ferramentas do Cerne via MCP) ----
# Token próprio do servidor MCP (/mcp) e do proxy mascarador p/ o PicoClaw. Gere com: openssl rand -hex 32
CERNE_MCP_TOKEN=
# Bot do Telegram (@BotFather) + IDs autorizados (@userinfobot), separados por vírgula.
# O canal só liga com os DOIS preenchidos. Depois: python3 picoclaw/render_config.py && docker compose up -d picoclaw
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOW_FROM=
