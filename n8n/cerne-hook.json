{
  "name": "Cerne Hooks — Ingerir + Agente",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "cerne-hook",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "11111111-1111-1111-1111-111111111111",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "cerne-hook"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://cerne-app:8000/ingest",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ text: $json.body.texto, source: ($json.body.source || 'n8n-hook') }) }}",
        "options": {}
      },
      "id": "22222222-2222-2222-2222-222222222222",
      "name": "Ingerir no Cerne",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [480, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://cerne-app:8000/agent",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ message: $('Webhook').item.json.body.pergunta }) }}",
        "options": {}
      },
      "id": "33333333-3333-3333-3333-333333333333",
      "name": "Perguntar ao Agente",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [720, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ resposta: $json.answer, ferramentas: $json.ferramentas, session_id: $json.session_id }) }}",
        "options": {}
      },
      "id": "44444444-4444-4444-4444-444444444444",
      "name": "Responder",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [960, 300]
    }
  ],
  "connections": {
    "Webhook": { "main": [[{ "node": "Ingerir no Cerne", "type": "main", "index": 0 }]] },
    "Ingerir no Cerne": { "main": [[{ "node": "Perguntar ao Agente", "type": "main", "index": 0 }]] },
    "Perguntar ao Agente": { "main": [[{ "node": "Responder", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" },
  "active": false
}
