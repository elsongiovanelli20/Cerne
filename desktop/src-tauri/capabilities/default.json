{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissões do Cerne Desktop (janela principal + ingestão + agente + navegador).",
  "windows": ["main", "ingest", "agente", "navegador"],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "core:window:allow-close",
    "core:event:default",
    "dialog:default",
    "shell:allow-open"
  ]
}
