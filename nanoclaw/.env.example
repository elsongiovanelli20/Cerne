# --- Ponte de modelos: NanoClaw -> gateway do Cerne (soberano) ---
# O Claude Agent SDK (base do NanoClaw) honra estas variáveis. Apontando para o
# gateway do Cerne, os agentes usam modelos LOCAIS (Ollama) sem chave da Anthropic.

# Na MESMA rede docker do Cerne (compose): use o nome do serviço/container.
ANTHROPIC_BASE_URL=http://cerne-gateway:4000
# Em host separado, use o domínio atrás do Caddy:
# ANTHROPIC_BASE_URL=https://litellm.orqion-ia.com.br

# Chave MESTRA do gateway (do .env do Cerne: LITELLM_MASTER_KEY). NÃO é chave da Anthropic.
ANTHROPIC_API_KEY=sk-cerne-troque-pela-LITELLM_MASTER_KEY

# Alias soberano registrado no gateway (gateway/litellm-config.yaml): agent | chat
# Para híbrido (externo com PII mascarada), reaponte o alias 'agent' no gateway.
ANTHROPIC_MODEL=agent

# --- Governança (Fase 2): o Cerne Web orquestra e audita ---
# URL interna do Cerne Web para o NanoClaw reportar execuções/auditoria.
CERNE_WEB_URL=http://cerne-app:8000
